# Пароль адміністратора за замовчуванням (використовується лише один раз,
# при першому запуску, щоб створити обліковий запис адміністратора).
# Після цього пароль можна змінити в Керування → Налаштування → Безпека.
ADMIN_PASSWORD=padelhub2026

# Секрет для підпису сесії адміністратора. Згенеруйте випадковий рядок,
# наприклад командою: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-a-random-string

# (необов'язково) Куди зберігати файл бази даних SQLite.
# За замовчуванням: ./data/padelhub.db
# DATABASE_PATH=/var/data/padelhub.db

PORT=3000
NODE_ENV=production
